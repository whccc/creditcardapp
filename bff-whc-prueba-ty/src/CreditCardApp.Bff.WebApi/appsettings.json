{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Information"
    }
  },
  "AllowedHosts": "*",
  "CoreApi": {
    "AuthenticationBaseUrl": "http://localhost:5100",
    "CardsBaseUrl": "http://localhost:5100",
